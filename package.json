{
  "name": "dsh-kimi-code",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: run the locally installed Kimi Code CLI as a sub-agent for development work and code review.",
  "author": "kangseung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kangseung/dsh-kimi-code.git"
  },
  "homepage": "https://github.com/kangseung/dsh-kimi-code#readme",
  "bugs": {
    "url": "https://github.com/kangseung/dsh-kimi-code/issues"
  },
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "kimi",
    "kimi-code",
    "subagent",
    "code-review"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
